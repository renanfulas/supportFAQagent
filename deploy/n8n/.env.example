# Copy to .env on the VPS and fill private values there.
# Never commit real .env values.

# Pin a tested n8n version. Do not use "latest" for staging/production.
N8N_IMAGE_TAG=

# Public URL if n8n is exposed through HTTPS reverse proxy.
# Example: n8n.ordens.com.br
N8N_HOST=
N8N_PROTOCOL=https
WEBHOOK_URL=
N8N_EDITOR_BASE_URL=
N8N_PROXY_HOPS=1

# Loopback port used by the reverse proxy.
N8N_PORT=5678

# Generate privately on the VPS:
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Timezone.
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# n8n diagnostics should stay off for this staging setup.
N8N_DIAGNOSTICS_ENABLED=false

# Dedicated PostgreSQL for n8n. Do not reuse supportFAQagent database.
N8N_POSTGRES_DB=n8n
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=
