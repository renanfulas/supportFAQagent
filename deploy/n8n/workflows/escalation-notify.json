{
  "name": "supportfaq-escalation-notify-template",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "handoff-webhook",
      "name": "Verified Handoff Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "supportfaq/internal/handoff",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "notify-group",
      "name": "Notify Internal WhatsApp Group",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.EVOLUTION_API_BASE_URL + '/message/sendText/' + $vars.EVOLUTION_INSTANCE_NAME }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Idempotency-Key",
              "value": "={{ $('Verified Handoff Webhook').item.json.headers['x-idempotency-key'] || $json.request_id }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({number: $vars.HANDOFF_GROUP_ID, text: 'Request ' + $json.request_id + '\\nMotivos: ' + ($json.handoff_reasons || []).join(', ') + '\\nResumo: ' + ($json.summary || '')}) }}"
      }
    },
    {
      "id": "respond",
      "name": "Respond Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [520, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {status: 'accepted', request_id: $json.request_id} }}"
      }
    }
  ],
  "connections": {
    "Verified Handoff Webhook": {
      "main": [[{"node": "Notify Internal WhatsApp Group", "type": "main", "index": 0}]]
    },
    "Notify Internal WhatsApp Group": {
      "main": [[{"node": "Respond Accepted", "type": "main", "index": 0}]]
    }
  },
  "pinData": {},
  "tags": []
}
