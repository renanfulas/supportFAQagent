{
  "name": "supportfaq-web-otp-delivery-template",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "otp-webhook",
      "name": "Verified OTP Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "supportfaq/internal/otp",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "send-otp",
      "name": "Send OTP Through Evolution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.EVOLUTION_API_BASE_URL + '/message/sendText/' + $vars.EVOLUTION_INSTANCE_NAME }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Idempotency-Key",
              "value": "={{ $('Verified OTP Webhook').item.json.headers['x-idempotency-key'] || $json.delivery_id }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({number: $json.phone_e164, text: 'Seu codigo de verificacao e ' + $json.variables.code + '. Ele expira em ' + $json.variables.expires_in_minutes + ' minutos.'}) }}"
      }
    },
    {
      "id": "respond",
      "name": "Respond Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [520, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {status: 'accepted', delivery_id: $json.delivery_id} }}"
      }
    }
  ],
  "connections": {
    "Verified OTP Webhook": {
      "main": [[{"node": "Send OTP Through Evolution", "type": "main", "index": 0}]]
    },
    "Send OTP Through Evolution": {
      "main": [[{"node": "Respond Accepted", "type": "main", "index": 0}]]
    }
  },
  "pinData": {},
  "tags": []
}
