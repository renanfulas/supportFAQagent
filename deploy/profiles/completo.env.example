# Perfil "completo": o padrao mais WhatsApp oficial (Meta Cloud API), login do
# cliente por OTP no WhatsApp, consentimento LGPD no handoff, console web do time
# e Redis para o estado de sessao.
#
#   bash deploy/install.sh --profile completo
#   python -m scripts.config_validate --env-file .env
#
# O install.sh gera todo <set-private-value>. Todo <set-provider-value> vem de um
# fornecedor (LLM, Meta) e precisa ser colado por quem instala. Nunca cole
# valores reais em issue, PR, chat ou documento. Runbook: docs/runbooks/docker-install.md
# Antes de ligar em producao: docs/runbooks/meta-whatsapp-private-smoke.md

# Perfil desta configuracao; o config validate cobra o que o perfil exige.
CONFIG_PROFILE=completo

# --- compose -------------------------------------------------------------------
# Perfis do compose: "db" sobe o Postgres+pgvector embarcado; "redis" sobe o cache.
COMPOSE_PROFILES=db,redis
# Pasta do pacote do cliente (dominios + installation.yaml), montada read-only.
CLIENT_PACK_DIR=./domains
APP_PORT=8000
# IP do reverse proxy visto de dentro do container (ex.: gateway da rede Docker).
FORWARDED_ALLOW_IPS=127.0.0.1

# --- app -----------------------------------------------------------------------
APP_NAME=supportFAQagent
APP_ENV=production
DEFAULT_DOMAIN=suporte-vps-whatsapp
API_SECRET_KEY=<set-private-value>

# Provider de LLM: preencha um dos dois (com Anthropic, deixe OPENAI_API_KEY vazia).
# A busca semantica (pgvector) usa embeddings da OpenAI.
OPENAI_API_KEY=<set-provider-value>
ANTHROPIC_API_KEY=

# --- banco (perfil "db") -------------------------------------------------------
POSTGRES_DB=supportfaq
POSTGRES_USER=supportfaq
POSTGRES_PASSWORD=<set-private-value>
# Host "postgres" e o servico do compose. Com banco externo, aponte para ele.
DATABASE_URL=postgresql://supportfaq:<set-private-value>@postgres:5432/supportfaq

# Chave do hash de sessao. Precisa existir ANTES das migrations (a 007 grava a
# impressao dela) e nao deve mudar depois.
PERSISTENCE_HASH_SECRET=<set-private-value>
# Chave do hash de telefone do console do time (operadores e identidades).
# Trocar depois obriga a recadastrar cada operador.
IDENTITY_HASH_SECRET=<set-private-value>
PERSISTENCE_BACKEND=postgres
# Busca lexical ate ingerir os dominios no pgvector (ver runbook):
#   RETRIEVAL_BACKEND=pgvector
RETRIEVAL_BACKEND=lexical
# Memoria do dominio escolhido por conversa, duravel entre restarts.
SESSION_DOMAIN_STORE_BACKEND=postgres

# --- chat publico no site ------------------------------------------------------
# Pagina em /chat-ui e API em /web/chat, atras do reverse proxy HTTPS (cookie Secure obrigatorio).
ENABLE_PUBLIC_CHAT_UI=true
WEB_CHAT_COOKIE_SECURE=true
WEB_CHAT_RATE_LIMIT_PER_MINUTE=10

# --- atendimento humano --------------------------------------------------------
# Caixa de handoffs para o time (API /internal/support-cases, protegida pela API_SECRET_KEY).
ENABLE_SUPPORT_INBOX=true
# Console web do time em /web/support (login do operador por OTP no WhatsApp).
ENABLE_SUPPORT_CONSOLE=true
SUPPORT_CONSOLE_TIMEZONE=America/Sao_Paulo

# --- login do cliente por WhatsApp (OTP) ---------------------------------------
ENABLE_WEB_WHATSAPP_AUTH=true
WEB_AUTH_STORAGE_BACKEND=postgres
WEB_AUTH_OTP_DELIVERY_TRANSPORT=meta
# Diferente de IDENTITY_HASH_SECRET; o install.sh gera.
OTP_DIGEST_SECRET=<set-private-value>
# Consentimento LGPD antes de passar a conversa para um humano.
ENABLE_HANDOFF_CONSENT_GATE=true

# --- WhatsApp oficial (Meta Cloud API) -----------------------------------------
# Webhook publico em /integrations/meta/whatsapp/webhook, atras do proxy HTTPS.
ENABLE_META_WHATSAPP_WEBHOOK=true
ENABLE_META_WHATSAPP_CHAT=true
# Do app da Meta (Business Manager):
META_WHATSAPP_ACCESS_TOKEN=<set-provider-value>
META_WHATSAPP_APP_SECRET=<set-provider-value>
META_WHATSAPP_PHONE_NUMBER_ID=<set-provider-value>
META_WHATSAPP_WABA_ID=
META_WHATSAPP_OTP_TEMPLATE_NAME=<set-provider-value>
META_WHATSAPP_OTP_TEMPLATE_LANGUAGE=pt_BR
# Token que voce escolhe e cola tambem no painel da Meta; o install.sh gera.
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=<set-private-value>

# --- start seguro (scripts/safe_start.py) --------------------------------------
# auto: banco novo e vazio recebe as migrations no start, sob lock. Banco que ja
# passou do bootstrap nunca e migrado sozinho (migration nova: runbook).
# off: nao toca no schema; o readiness continua barrando migration pendente.
STARTUP_MIGRATIONS=auto
# Quanto o start espera o banco e o readiness antes de desistir (segundos).
STARTUP_READINESS_TIMEOUT_SECONDS=60

# --- redis (perfil do compose "redis") -----------------------------------------
SESSION_STATE_BACKEND=redis
SESSION_STATE_REDIS_URL=redis://redis:6379/0
