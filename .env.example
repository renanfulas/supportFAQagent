APP_NAME=supportFAQagent
APP_ENV=development
DEFAULT_DOMAIN=suporte-vps-whatsapp
DOMAINS_PATH=domains
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
RECALL_API_KEY=
ZOOM_WEBHOOK_SECRET=

# Database and secret placeholders for local/private setup only.
DATABASE_URL=
RETRIEVAL_BACKEND=lexical
PERSISTENCE_BACKEND=disabled
PERSISTENCE_HASH_SECRET=
PERSISTENCE_HASH_VERSION=hmac-sha256-v1
# Sticky WhatsApp domain memory: "memory" (ephemeral, per-process) or "postgres"
# (durable across restarts/workers, migration 011). postgres requires
# PERSISTENCE_BACKEND=postgres.
SESSION_DOMAIN_STORE_BACKEND=memory
CONVERSATION_RETENTION_DAYS=60
CONVERSATION_HISTORY_MESSAGES=8
OTP_RETENTION_DAYS=7
OUTBOX_DELIVERED_RETENTION_DAYS=30
WEBHOOK_RECEIPT_RETENTION_DAYS=30
RETENTION_BATCH_SIZE=1000
RETENTION_MAX_BATCHES=10
RETENTION_QUERY_TIMEOUT_SECONDS=60
HEALTH_PGVECTOR_MIN_DOMAIN_EMBEDDINGS=1
HEALTH_OUTBOX_READY_DEGRADED_COUNT=100
HEALTH_OUTBOX_OLDEST_READY_DEGRADED_SECONDS=300
OUTBOX_PROCESSING_STALE_SECONDS=300
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_QUERY_TIMEOUT_SECONDS=10
DATABASE_MIGRATION_LOCK_TIMEOUT_SECONDS=10
DATABASE_MIGRATION_STATEMENT_TIMEOUT_SECONDS=120
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
CONVERSATION_BACKFILL_BATCH_SIZE=250
CONVERSATION_BACKFILL_LOCK_TIMEOUT_SECONDS=10
CONVERSATION_BACKFILL_QUIET_PERIOD_SECONDS=300
HANDOFF_WEBHOOK_URL=
WHATSAPP_MESSAGE_WEBHOOK_URL=
OTP_DELIVERY_WEBHOOK_URL=
OUTBOX_HANDOFF_DELIVERY_TRANSPORT=internal_webhook
OUTBOX_WHATSAPP_MESSAGE_DELIVERY_TRANSPORT=internal_webhook
OUTBOX_OTP_DELIVERY_TRANSPORT=internal_webhook
OUTBOX_WEBHOOK_SECRET=
ENABLE_OUTBOX_INGRESS=false
# Support-team WhatsApp alert on handoff (Sprint 5). Dark by default: with the
# flag off no whatsapp.message.requested events are enqueued. Recipients is a
# comma-separated list of internal verified numbers. Actual delivery is still
# controlled by OUTBOX_WHATSAPP_MESSAGE_DELIVERY_TRANSPORT (set meta_whatsapp to
# send, disabled to keep events auditable without sending).
ENABLE_SUPPORT_TEAM_WHATSAPP_NOTIFY=false
SUPPORT_TEAM_WHATSAPP_RECIPIENTS=
# Append-only insurance sink: fan out every persisted turn off the hot path.
# Requires PERSISTENCE_BACKEND=postgres to have turns to archive.
ENABLE_CONVERSATION_ARCHIVE=false
OUTBOX_CONVERSATION_ARCHIVE_TRANSPORT=append_only_sink
# Sink transport: append_only_file (local stopgap) or s3 (durable off-box).
CONVERSATION_ARCHIVE_SINK_TRANSPORT=append_only_file
# append_only_file:
CONVERSATION_ARCHIVE_SINK_PATH=
# s3 (S3-compatible: AWS S3, Cloudflare R2, Backblaze B2, MinIO). Credentials come
# from the standard AWS/boto3 chain (env vars or instance role), never from here.
# Requires the 's3' extra: pip install '.[s3]'
CONVERSATION_ARCHIVE_SINK_BUCKET=
CONVERSATION_ARCHIVE_SINK_PREFIX=conversations
CONVERSATION_ARCHIVE_SINK_ENDPOINT_URL=
CONVERSATION_ARCHIVE_SINK_REGION=
# Verified delivery webhook targets.
VERIFIED_HANDOFF_WEBHOOK_URL=
VERIFIED_WHATSAPP_WEBHOOK_URL=
VERIFIED_OTP_WEBHOOK_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Required outside APP_ENV=development/dev/local.
API_SECRET_KEY=
RATE_LIMIT_PER_MINUTE=30
ENABLE_CHAT_UI=false
# Public website chat V0. Recommended for staging:
# ENABLE_PUBLIC_CHAT_UI=true
# WEB_CHAT_RATE_LIMIT_PER_MINUTE=10
# WEB_CHAT_SESSION_COOKIE=sfaq_web_session_staging
# WEB_CHAT_COOKIE_SECURE=true
ENABLE_PUBLIC_CHAT_UI=false
WEB_CHAT_RATE_LIMIT_PER_MINUTE=10
WEB_CHAT_SESSION_COOKIE=sfaq_web_session
WEB_CHAT_COOKIE_SECURE=
PROJECT_LLM_API_KEY_ALIAS=

# WhatsApp OTP V1A. Keep disabled until the private lab flow is configured.
ENABLE_WEB_WHATSAPP_AUTH=false
WEB_AUTH_STORAGE_BACKEND=memory
OTP_CODE_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_START_LIMIT_PER_IP_PER_HOUR=10
OTP_START_LIMIT_PER_PHONE_PER_15_MINUTES=3
# Use two different private random secrets. Do not reuse API_SECRET_KEY.
IDENTITY_HASH_SECRET=
OTP_DIGEST_SECRET=

# Meta WhatsApp Cloud API native integration. Keep disabled until private webhook
# and phone-number assets are configured.
ENABLE_META_WHATSAPP_WEBHOOK=false
ENABLE_META_WHATSAPP_CHAT=false
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_WABA_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_GRAPH_API_VERSION=v25.0
META_WHATSAPP_REQUEST_TIMEOUT_SECONDS=5
META_WHATSAPP_OTP_TEMPLATE_NAME=
META_WHATSAPP_OTP_TEMPLATE_LANGUAGE=pt_BR
WEB_AUTH_OTP_DELIVERY_TRANSPORT=memory

# WhatsApp domain routing: let one number serve more than one domain (support and
# sales) by keyword + initial menu. Off by default keeps the single default_domain
# behaviour. Order defines the menu numbering.
ENABLE_WHATSAPP_DOMAIN_ROUTER=false
WHATSAPP_ROUTER_DOMAINS=suporte-vps-whatsapp,vendas

# Temporary Hermes adapter. Use only as a bridge while Meta native activation is
# blocked; keep business rules, OTP validation, RAG and persistence in backend.
HERMES_BASE_URL=
HERMES_WEBHOOK_SECRET=

# Temporary Hermes conversational chat bridge (support/sales over WhatsApp via the
# bridge). Pilot only; keep disabled until the bridge forwards inbound to
# /integrations/hermes/chat/webhook. Inbound is verified with HERMES_WEBHOOK_SECRET;
# replies go to the bridge HERMES_BRIDGE_URL POST /send.
ENABLE_HERMES_CHAT=false
HERMES_BRIDGE_URL=http://127.0.0.1:3000
# Dedicated secret for the inbound chat forward HMAC, separate from the OTP secret.
# Must match HERMES_CHAT_FORWARD_SECRET configured on the bridge. Falls back to
# HERMES_WEBHOOK_SECRET when unset (not recommended).
HERMES_CHAT_FORWARD_SECRET=
HERMES_REQUEST_TIMEOUT_SECONDS=5
HERMES_OTP_DELIVERY_PATH=/otp-delivery
